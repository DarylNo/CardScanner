__pycache__/
*.pyc
*.pyo
.env
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
*.csv
*.json
!.env.example
scan_results.*

# Debug captures / scan images / verification snapshots — personal card
# photos and local camera frames, not project source.
debug/
*.jpg
*.jpeg
*.png

# Local Scryfall card-image cache (downloaded at runtime; lives under the
# user's home cache dir by default, but ignore defensively in case it's
# ever pointed at a project-local path).
.cache/
card_images/

# Web-app runtime artifacts
scans.db
*.db
.certs/

# Android release signing keys (scripts/make_android_keystore.py) — they live
# ONLY in the ANDROID_KEYSTORE_* repo secrets and the owner's backup.
*.p12
*.jks
*.keystore

# Test fixtures are source — keep them despite the *.json / image ignores above.
!tests/fixtures/
!tests/fixtures/**
# So is everything under the Android source sets — notably the parity fixtures
# (scripts/export_detect_fixtures.py) that CI's --check and the Kotlin tests
# read from the checkout. Keystores stay ignored by android/.gitignore.
!android/*/src/**
server.log
scan_images/

# Session logs / local build noise
*.log
tsc.out
pkgtest.log
.certs/
