__pycache__/
*.pyc
*.pyo
.env
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
*.csv
*.json
!.env.example
scan_results.*

# Debug captures / scan images / verification snapshots — personal card
# photos and local camera frames, not project source.
debug/
*.jpg
*.jpeg
*.png

# Local Scryfall card-image cache (downloaded at runtime; lives under the
# user's home cache dir by default, but ignore defensively in case it's
# ever pointed at a project-local path).
.cache/
card_images/

# Web-app runtime artifacts
scans.db
*.db
.certs/

# Test fixtures are source — keep them despite the *.json / image ignores above.
!tests/fixtures/
!tests/fixtures/**
server.log
