# Ollama API endpoint (OpenAI-compatible)
OLLAMA_ENDPOINT=http://localhost:11434/v1

# Vision model name (Ollama model tag — note: no hyphen between 2.5 and vl)
# Options: qwen2.5vl:3b  qwen2.5vl:7b  qwen2.5vl:32b  llava:13b
VISION_MODEL=qwen2.5vl:7b

# Webcam device index (0 = default/first camera)
CAMERA_INDEX=0

# Output file path — .csv or .json
OUTPUT_FILE=scan_results.csv
